# ==============================================================================
# TAIKO INFO - CONFIGURAÇÃO DE AMBIENTE
# ==============================================================================

# Caminho do banco de dados SQLite local
DB_PATH=app.db

# JID do Grupo do WhatsApp a ser monitorado
# Exemplo: 120363048999999999@g.us
# Se vazio, o daemon listener registrará os JIDs das mensagens recebidas no log
# para ajudar você a identificar o JID correto do seu grupo.
WHATSAPP_GROUP_JID=

# Chave de API do Google Gemini (obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini a ser utilizado
GEMINI_MODEL=gemini-1.5-flash

# Porta do Servidor Web Mural
HTTP_PORT=8080

# Nível de Log (INFO ou DEBUG)
LOG_LEVEL=INFO

# Fuso Horário de Referência para interpretação das datas da LLM
TIMEZONE=America/Sao_Paulo
